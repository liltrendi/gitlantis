{
  "extends": "@gitlantis/config-typescript/base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "baseUrl": ".",
    "paths": {
      "@/packages/shared/*": ["src/*"]
    },
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": false
  },
  "include": ["src/**/*.ts"]
}
